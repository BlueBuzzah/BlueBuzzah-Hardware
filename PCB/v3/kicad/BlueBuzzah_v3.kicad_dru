(version 1)
# EN's RC sits between U20's pins, U23 and Q1. The parts clear each other, but KiCad's 0.25 mm courtyard margins overlap.
(rule "EN RC beside the module"
  (condition "A.Reference == 'R67' || A.Reference == 'C45' || B.Reference == 'R67' || B.Reference == 'C45'")
  (constraint courtyard_clearance (min -1mm)))

# SW2 sits in the gap beside R43 and R45. The parts clear each other, but the switch's and KiCad's 0.25 mm courtyard margins overlap.
(rule "BOOT button in its gap"
  (condition "A.Reference == 'SW2' || B.Reference == 'SW2'")
  (constraint courtyard_clearance (min -1mm)))

# R70 sits between U21, R2 and SW1. The parts clear each other, but the courtyard margins overlap.
(rule "Power switch divider beside U21"
  (condition "A.Reference == 'R70' || B.Reference == 'R70'")
  (constraint courtyard_clearance (min -1mm)))
