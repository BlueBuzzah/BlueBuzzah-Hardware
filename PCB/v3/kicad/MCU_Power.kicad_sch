	(text "Charge current = 1000 V / R64 = 100 mA.\nChange R64 for a different battery."
		(exclude_from_sim no)
		(at 20.32 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d4f732f8-5179-4eb4-a1a1-d3eede30870d")
	)
	(text "With USB out, R5 and R4 on the top sheet are Q1's only gate pull-down.\nRemoving either floats the gate. R3 only isolates GPIO2 and can go."
		(exclude_from_sim no)
		(at 113.03 186.69 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5625fd15-0d93-407d-a16f-7a52d9fdefb6")
	)
	(text "Sliding SW1 off grounds SW_COM. GPIO3 reads low\nat once, and EN falls through R71 and C2, cutting\n3.3 V about 2 s later. GPIO3 is an input, so\nfirmware can't hold U23 on."
		(exclude_from_sim no)
		(at 143.51 143.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "04762b34-346f-4fc2-a01c-76d308e18c40")
	)
